# ========== LLM 配置 ==========
# 留空 = 离线演员（Mock）模式：零成本、全功能可玩
# 填入 DeepSeek key = 真实 AI 模式（OpenAI 兼容协议，也可换 Moonshot/OpenRouter 等）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== 数据库（docker compose 部署时自动使用服务名，无需改动）==========
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=chattheater
MYSQL_USER=chattheater
MYSQL_PASSWORD=chattheater123
MYSQL_ROOT_PASSWORD=chattheater123

# ========== 安全 ==========
# JWT 签名密钥，生产环境必须更换为 32 位以上随机串
JWT_SECRET=chattheater-dev-secret-please-change-in-production-0123456789
